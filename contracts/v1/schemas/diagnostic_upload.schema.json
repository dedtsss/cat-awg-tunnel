{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cat-awg.example/contracts/v1/diagnostic-upload.schema.json",
  "type": "object", "additionalProperties": false, "required": ["schemaVersion", "events"],
  "properties": {"schemaVersion": {"const": "cat.v1"}, "events": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"$ref": "#/$defs/event"}}},
  "$defs": {"event": {"type": "object", "additionalProperties": false, "required": ["id", "ts", "source", "category", "severity", "code", "summary", "details", "tunnelId"], "properties": {"id": {"type": "string", "minLength": 1}, "ts": {"type": "string", "format": "date-time"}, "source": {"const": "CLIENT"}, "category": {"enum": ["NETWORK", "TUNNEL", "DNS", "ROUTE", "SYSTEM", "PROBE", "CONFIG"]}, "severity": {"enum": ["INFO", "WARNING", "ERROR"]}, "code": {"type": "string", "minLength": 1}, "summary": {"type": "string", "minLength": 1}, "details": {"type": "object"}, "tunnelId": {"type": ["string", "null"]}}}}
}
